{
  "name": "globalex-me",
  "private": true,
  "version": "1.0.0",
  "description": "globalex.me \u2014 static site, Cloudflare Pages Functions backend",
  "scripts": {
    "build": "node _src/build.js",
    "test": "node _src/test.js",
    "og": "node _src/og-render.js",
    "geo": "node --stack-size=8000 _src/geo-build.js",
    "prompts": "node _src/product-images-build.js",
    "dev": "wrangler pages dev . --port 8788",
    "db:local": "wrangler d1 execute globalex --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute globalex --remote --file=./schema.sql",
    "docs:upload": "node _src/upload-docs.js",
    "seed:demo": "node _src/seed-demo.js",
    "images": "node _src/images-build.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
