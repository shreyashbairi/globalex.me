# Every *.html at the repo root is generated by `npm run build` from _src/.
# They are committed because Cloudflare Pages serves them directly (there is
# no [build] section in wrangler.toml), but they are output, not source.
# Marking them generated collapses them in review and keeps them out of
# language statistics, so a diff shows the _src/ change that caused them.
/*.html linguist-generated=true

# Same reasoning: emitted from _src/docs.js by build.js#emitDocCatalogue().
functions/_lib/docs.js linguist-generated=true
